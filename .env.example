APP_NAME=SDLabs
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FORUM_URL=
FORUM_API_KEY= //create 40character key, add to forum api key in database user 1 userid 1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null //used for forum cookies, .example.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Disk used by Spatie Media Library for design/component uploads (default: public).
# Point this at a Garage bucket in production. Run `php artisan storage:link` for the public disk.
MEDIA_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# To store media on Garage instead of the local disk, set MEDIA_DISK=garage_uploads
# and fill these. In Docker Compose the endpoint is the service name:
# GARAGE_ENDPOINT=http://garage:3900
# GARAGE_KEY=
# GARAGE_SECRET=
# GARAGE_REGION=garage
# GARAGE_BUCKET_UPLOADS=uploads
# GARAGE_BUCKET_ASSETS=assets
# GARAGE_BUCKET_TMP=tmp

# --- Docker Compose (read from this file for ${...} substitution; optional) ---
# APP_PORT=8080
# PHP_VERSION=8.4
# VITE_HMR_HOST=localhost      # set to your LAN IP/host for remote dev
# Forum DB creds (must match docker/forum.env when using --profile forum):
# FORUM_DB_NAME=flarum
# FORUM_DB_USER=flarum
# FORUM_DB_PASSWORD=flarum
# FORUM_DB_ROOT_PASSWORD=changeme

VITE_APP_NAME="${APP_NAME}"

services:
  dev:
    container_name: dev
    image: serversideup/php:8.5-fpm-apache
    ports:
      - "8080:8080"
    networks:
      - public_network
    environment:
      PHP_OPCACHE_ENABLE: "1"
      PHP_MEMORY_LIMIT: "512M"
      AUTORUN_ENABLED: "true"
    volumes:
      - ./:/var/www/html/

  flarum:
    image: mondedie/flarum:stable
    container_name: flarum_dev
    env_file:
      - ./forum.env
    volumes:
      - ./storage/forum/assets:/flarum/app/public/assets
      - ./storage/forum/extensions:/flarum/app/extensions
      - ./storage/forum/storage/logs:/flarum/app/storage/logs
      - ./storage/forum/nginx:/etc/nginx/flarum
      - ./storage/forum/storage/config.php:/flarum/app/config.php
    ports:
      - 8180:8888
    networks:
      - public_network

  node_dev:
    image: node:20-alpine
    container_name: node_dev
    working_dir: /app
    volumes:
      - ./:/app
    command: sh -c "npm install && npm install -y && npm run dev --https" #important: delete hotfile in public folder or else assets wont load properly!
    restart: always
    networks:
     - public_network

  garage_dev:
    image: dxflrs/garage:v2.3.0
    container_name: garage_dev
    volumes:
      - ./storage/garage/garage.toml:/etc/garage.toml
      - ./storage/garage/meta:/var/lib/garage/meta
      - ./storage/garage/data:/var/lib/garage/data
    restart: unless-stopped
    ports:
      - 3900:3900
      - 3901:3901
      - 3902:3902
      - 3903:3903
    networks:
      - public_network
      
  s3_webui_dev:
    image: khairul169/garage-webui:latest
    container_name: garage-webui
    restart: unless-stopped
    volumes:
      - ./storage/garage/garage.toml:/etc/garage.toml:ro #get garage.toml from garage.toml.example in same directory
    ports:
      - 3909:3909
    networks:
      - public_network
    environment:
      #No authentication, see github for authentication instructions.
      API_BASE_URL: "http://garage_dev:3903"
      S3_ENDPOINT_URL: "http://garage_dev:3900"

networks:
 public_network:
services:
  dev:
    container_name: dev
    image: serversideup/php:8.5-fpm-apache
    ports:
      - "8080:8080" #left side is public facing port
    environment:
      PHP_OPCACHE_ENABLE: "1"
      PHP_MEMORY_LIMIT: "512M"
      AUTORUN_ENABLED: "true"
    volumes:
      - ./:/var/www/html/
    depends_on:
      db:
        condition: service_healthy

  db:
    image: mysql:8.4            # pinned
    container_name: db
    restart: always
    ports:
      - "3306:3306"
    environment:
      MYSQL_DATABASE: app       # creates the "app" DB and grants "dev" on it
      MYSQL_USER: dev
      MYSQL_PASSWORD: password
      MYSQL_ROOT_PASSWORD: password
    volumes:
      - ./storage/mysql/:/var/lib/mysql
      - ./storage/mysql-init/:/docker-entrypoint-initdb.d/   # creates the flarum DB too
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "127.0.0.1", "-uroot", "-ppassword"]
      interval: 5s
      timeout: 5s
      retries: 12

  phpmyadmin: #not required but nice to have
    image: phpmyadmin
    container_name: db_admin
    restart: always
    ports:
      - "8280:80"
    environment:
      - PMA_ARBITRARY=1
      - PMA_HOST=db
    depends_on:
      db:
        condition: service_healthy

  flarum:
    image: mondedie/flarum:stable
    container_name: flarum_dev
    env_file:
      - ./storage/forum/forum.env
    volumes:
      - ./storage/forum/assets:/flarum/app/public/assets
      - ./storage/forum/extensions:/flarum/app/extensions
      - ./storage/forum/storage/logs:/flarum/app/storage/logs
      - ./storage/forum/nginx:/etc/nginx/flarum
      - ./storage/forum/storage/config.php:/flarum/app/config.php
    ports:
      - "8180:8888"
    depends_on:
      db:
        condition: service_healthy

  node_dev:
    image: node:20-alpine
    container_name: node_dev
    working_dir: /app
    volumes:
      - ./:/app
    command: sh -c "npm install && npm run dev"
    ports:
      - "5173:5173"
    restart: unless-stopped
    depends_on:
      - dev

  garage_dev:
    image: dxflrs/garage:v2.3.0
    container_name: garage_dev
    command: /garage server --single-node
    volumes:
      - ./storage/garage/garage.toml:/etc/garage.toml
      - ./storage/garage/meta:/var/lib/garage/meta
      - ./storage/garage/data:/var/lib/garage/data
    restart: unless-stopped
    ports:
      - "3900:3900"
      - "3901:3901"
      - "3902:3902"
      - "3903:3903"

  s3_webui_dev:
    image: khairul169/garage-webui:latest
    container_name: garage-webui
    restart: unless-stopped
    volumes:
      - ./storage/garage/garage.toml:/etc/garage.toml:ro
    ports:
      - "3909:3909"
    environment:
      API_BASE_URL: "http://garage_dev:3903"
      S3_ENDPOINT_URL: "http://garage_dev:3900"
    depends_on:
      - garage_dev

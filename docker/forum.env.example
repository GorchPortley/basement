# Flarum (mondedie/flarum) config template — copy to forum.env and edit:
#
#   cp docker/forum.env.example docker/forum.env
#
# DB_HOST points at the bundled `forum-db` service (compose --profile forum).
# Keep these values in sync with the FORUM_DB_* settings in your compose .env.

# Public URL where the forum is reached (used for links + SSO cookies).
FORUM_URL=http://localhost:8180
DEBUG=false

# Database — matches the forum-db (MariaDB) service defaults.
DB_HOST=forum-db
DB_PORT=3306
DB_NAME=flarum
DB_USER=flarum
DB_PASS=flarum
DB_PREF=flarum_

# Initial admin account (change these).
FLARUM_ADMIN_USER=admin
FLARUM_ADMIN_PASS=changeme
FLARUM_ADMIN_MAIL=admin@example.com
FLARUM_TITLE=SDLabs Forum

# --- SSO bridge with the Laravel app ---
# Generate a 40-char API key inside Flarum (Admin > API keys) and set the SAME
# value here and as FORUM_API_KEY in the app's .env. See ForumAuthenticationController.
# API keys are created in-app, not via env — this is a reminder, not a setting.

DEBUG=true
FORUM_URL=http://localhost:8180 # Modify for your configuration

# Database — points at the "db" service, uses the flarum DB created by mysql-init
DB_HOST=db
DB_PORT=3306
DB_NAME=flarum # Stays separate from app db by default
DB_USER=dev
DB_PASS=password
DB_PREF=flarum_

# First-install admin account (password must be at least 8 chars)
FLARUM_ADMIN_USER=changeme
FLARUM_ADMIN_PASS=changeme
FLARUM_ADMIN_MAIL=admin@example.com
FLARUM_TITLE=Dev_Forum

# Match your host user so the mounted volumes are writable
UID=1000
GID=1000
